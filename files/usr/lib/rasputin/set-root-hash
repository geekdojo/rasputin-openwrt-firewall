#!/bin/sh
#
# set-root-hash — install a root password HASH delivered by the control plane
# into /etc/shadow. The image never bakes a root password; the control plane's
# first-run wizard sets one and a job pushes the resulting hash to every node,
# and nodes that join later receive it at enrol (geekdojo/geekdojo-brain#558).
# This is the firewall-image side of that: it takes a hash and applies it. The
# control-plane side (wizard, the push job, the Settings "change root password
# on all nodes" action, and the agent command that invokes this) is a separate
# story.
#
# CONTRACT
#   - The argument (or, with no argument, one line on stdin) is a crypt(3)
#     password HASH — a value ready to go into /etc/shadow's password field —
#     NOT a plaintext password. Deliver a hash, never the password
#     (#558); this refuses anything that is not already a hash so a plaintext
#     can never be stored verbatim as if it were one.
#   - Accepted: a modular-crypt hash ($id$... — e.g. $6$, $5$, $y$, $2y$) or an
#     explicit lock token (* or !). Rejected: empty, a bare non-$ string, or a
#     value containing ':' or whitespace (either would corrupt the shadow row).
#   - The hash is secret material: it is never logged, printed, or written
#     anywhere but /etc/shadow, and never copied to a job ledger (#558). Error
#     messages describe the shape, never the value.
#   - Atomic and idempotent: writes a 0600 temp file beside /etc/shadow and
#     renames it, so a failure leaves the old file whole; re-applying the same
#     hash is a no-op-equivalent (same result).
#
# EXIT: 0 on success (root's field now equals the hash), non-zero otherwise,
# having changed nothing.
#
# Usage:
#   set-root-hash '$6$saltsalt$hash...'
#   printf '%s' "$HASH" | set-root-hash

set -eu

# /etc/shadow in production. RASPUTIN_SHADOW_FILE lets the behaviour tests point
# it at a scratch file; it is never set on the box.
SHADOW="${RASPUTIN_SHADOW_FILE:-/etc/shadow}"

die() {
	# Never include the candidate value — it is secret.
	logger -t rasputin "set-root-hash: ERROR: $1"
	printf 'set-root-hash: ERROR: %s\n' "$1" >&2
	exit 1
}

if [ "$#" -ge 1 ]; then
	HASH="$1"
else
	# One line on stdin; strip a trailing newline only.
	HASH="$(cat)"
fi

# Trim surrounding whitespace and any CR (a hash delivered/edited on Windows).
HASH="$(printf '%s' "$HASH" | tr -d '\r' | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"

[ -n "$HASH" ] || die "no hash given (argument or stdin); nothing changed"

# A shadow password field must not contain ':' (the field separator) or any
# whitespace. Reject rather than corrupt the row.
case "$HASH" in
	*:* )               die "hash contains ':', which is not valid in a shadow field; nothing changed" ;;
	*[[:space:]]* )     die "hash contains whitespace, which is not valid in a shadow field; nothing changed" ;;
esac

# Must be a real crypt hash or an explicit lock token — never a plaintext.
case "$HASH" in
	'*'|'!' )           : ;;                      # explicit lock
	'$'?*'$'* )         : ;;                      # modular crypt: $id$...$...
	* )                 die "value is not a crypt hash (expected \$id\$... or a lock token); a plaintext password is refused; nothing changed" ;;
esac

[ -f "$SHADOW" ] || die "$SHADOW not found; nothing changed"
grep -q '^root:' "$SHADOW" || die "no root line in $SHADOW; nothing changed"

tmp="$SHADOW.rasputin.$$"
trap 'rm -f "$tmp" 2>/dev/null || true' EXIT

# Rewrite only the second field of the root line. OFS reconstitutes the row
# with every other field intact.
if ! awk -v h="$HASH" -F: 'BEGIN{OFS=":"} $1=="root"{$2=h} {print}' "$SHADOW" > "$tmp" 2>/dev/null; then
	die "could not write temporary shadow file; nothing changed"
fi
chmod 600 "$tmp" 2>/dev/null || die "could not set mode on temporary shadow file; nothing changed"

# Confirm the root field now equals the delivered hash before committing, and
# that the row still parses (7 ':' => 8 fields, a well-formed shadow row).
verify="$(awk -F: '$1=="root"{print $2; exit}' "$tmp")"
[ "$verify" = "$HASH" ] || die "verification of the rewritten root field failed; nothing changed"
fields="$(awk -F: '$1=="root"{print NF; exit}' "$tmp")"
[ "$fields" -ge 8 ] 2>/dev/null || die "rewritten root row is malformed; nothing changed"

mv -f "$tmp" "$SHADOW" || die "could not replace $SHADOW; nothing changed"
trap - EXIT

logger -t rasputin "set-root-hash: applied a control-plane-delivered root password hash [#558]"
exit 0
