#!/bin/sh
#
# apply-seed — read /etc/rasputin/seed.env (if present) and sync it into
# /etc/config/rasputin (the UCI config the agent reads).
#
# Three call sites:
#   - First-boot uci-defaults/99-rasputin (runs once, may have blank seed).
#   - Operator workflow: edit /etc/rasputin/seed.env then run this script.
#   - Controlplane bootstrap_firewall job: pushes the seed, then runs this
#     remotely via the agent.
#
# Idempotent. Blank values are valid — the agent polls and waits when
# nats_url or join_token is empty.

set -eu

SEED=/etc/rasputin/seed.env

# Defaults — overridden by seed.env if present.
RASPUTIN_NODE_ROLE=firewall
RASPUTIN_NODE_ID=
# The cluster's name (ADR-0003). Defaults to "rasputin" so a firewall whose
# seed predates per-cluster naming keeps resolving the control plane at
# rasputin.local — which on this box is load-bearing: musl has no nss-mdns, so
# the agent's hostsync republishing this name into dnsmasq is the ONLY way
# tailscaled reaches the mesh login server.
RASPUTIN_CLUSTER_ID=rasputin
RASPUTIN_NATS_URL=
RASPUTIN_CP_JOIN_TOKEN=
RASPUTIN_SSH_AUTHORIZED_KEY=

if [ -f "$SEED" ]; then
	# shellcheck disable=SC1090
	. "$SEED"
	logger -t rasputin "apply-seed: loaded seed from $SEED"
else
	logger -t rasputin "apply-seed: $SEED not found; writing blank config (agent polls)"
fi

# Seed-supplied SSH authorized key → /etc/dropbear/authorized_keys (the path
# OpenWrt's dropbear reads natively; the overlay is writable, unlike the
# Buildroot OS where the equivalent lands on the persistent partition). This
# is the ONLY way a key gets on the box — images bake none (pre-GA vendor-key
# removal, 2026-07-09). Append-if-missing: the file is operator-owned —
# manual additions survive, revocation is a manual edit. dropbear reads the
# file per auth attempt, so no service restart is needed. Public key, not a
# secret — never let a merge hiccup fail the seed apply (all call sites
# tolerate this block no-oping).
if [ -n "${RASPUTIN_SSH_AUTHORIZED_KEY:-}" ]; then
	mkdir -p /etc/dropbear
	touch /etc/dropbear/authorized_keys
	chmod 600 /etc/dropbear/authorized_keys
	if grep -qxF -- "$RASPUTIN_SSH_AUTHORIZED_KEY" /etc/dropbear/authorized_keys; then
		logger -t rasputin "apply-seed: seed SSH key already in /etc/dropbear/authorized_keys"
	else
		printf '%s\n' "$RASPUTIN_SSH_AUTHORIZED_KEY" >> /etc/dropbear/authorized_keys \
			&& logger -t rasputin "apply-seed: appended seed SSH key to /etc/dropbear/authorized_keys" \
			|| logger -t rasputin "apply-seed: WARNING — failed to write seed SSH key (continuing)"
	fi
fi

# Re-assert key-only SSH whenever an authorized key exists.
# 96-rasputin-dropbear-harden already disables password auth unconditionally
# at first boot (and self-deletes); this block is defense-in-depth for the
# life of the install — key-only is the product posture, so any later
# apply-seed run (operator re-run, bootstrap_firewall push) puts it back
# even if someone flipped it. dropbear reads PasswordAuth from UCI at start;
# reload picks it up on a running box and is a harmless no-op pre-procd on
# first boot.
if [ -s /etc/dropbear/authorized_keys ]; then
	if [ "$(uci -q get dropbear.@dropbear[0].PasswordAuth)" != "off" ]; then
		uci -q batch <<'EOF'
set dropbear.@dropbear[0].PasswordAuth='off'
set dropbear.@dropbear[0].RootPasswordAuth='off'
commit dropbear
EOF
		/etc/init.d/dropbear reload 2>/dev/null || true
		logger -t rasputin "apply-seed: dropbear hardened to key-only SSH (authorized key present)"
	fi
fi

# --- node id ---------------------------------------------------------------
# The id is the NATS username the agent presents to the bus, and the control
# plane accepts only a DNS label: 1-63 characters of a-z, 0-9 and '-', not
# starting or ending with '-'. The helpers and the reasoning behind the two
# behaviours below live in node-id.sh.
# shellcheck source=/dev/null
. /usr/lib/rasputin/node-id.sh

# A provisioning matched set ASSIGNS the node id in the seed and binds the
# join token to it (token-provisioning-pipeline.md §3) — so a seed-provided id
# wins over the on-box derivation, otherwise the bound token wouldn't match.
# Hand-flashed / un-provisioned boxes (blank seed id) still self-derive below.
#
# A seed id is lowercased and trimmed, exactly as rasputin-provision does, and
# then must already be valid. It is NOT rewritten into something valid: the
# token is bound to the id the operator chose, so a substituted id could never
# join and would hide why. Fail instead — before /etc/config/rasputin is
# touched, so a box that was already provisioned keeps its working config and
# a fresh one stays unprovisioned (99-rasputin then also leaves the token on
# the seed FAT). The SSH key above has already been applied on purpose: it is
# how the operator gets in to read this and fix the seed.
NODE_ID=$(rasputin_label_canon "${RASPUTIN_NODE_ID:-}")
if [ -n "$NODE_ID" ]; then
	if ! rasputin_label_valid "$NODE_ID"; then
		for msg in \
			"apply-seed: ERROR: RASPUTIN_NODE_ID '$RASPUTIN_NODE_ID' in $SEED is not a valid node id." \
			"apply-seed: a node id must be 1-63 characters of a-z, 0-9 and -, and must not start or end with -." \
			"apply-seed: nothing was applied. Fix RASPUTIN_NODE_ID in $SEED (it must match the id the join token was issued for) and run /usr/lib/rasputin/apply-seed again."
		do
			logger -t rasputin "$msg"
			printf '%s\n' "$msg" >&2
		done
		exit 1
	fi
else
	# Pick a stable per-box node_id. DMI serials are the right thing IF the
	# board vendor actually filled them in; rasputin_dmi_node_id skips the
	# placeholder strings many boards ship and normalizes a real serial into a
	# valid id (vendor serials are often uppercase and may contain spaces).
	NODE_ID=$(rasputin_dmi_node_id)
	# DMI didn't give us anything usable. Fall through to a persistent UUID
	# we manage ourselves at /etc/rasputin/node-id. OpenWrt doesn't ship
	# /etc/machine-id (that's a systemd convention; OpenWrt uses procd).
	# /etc/rasputin/ is in the sysupgrade keep-list (see
	# files/lib/upgrade/keep.d/rasputin) so this id is stable across reboots
	# AND across sysupgrade, but regenerates on a true re-flash (overlay
	# wiped). That's exactly the identity semantics we want — same box +
	# same install = same node_id; different box OR fresh re-flash = new
	# identity. The kernel's /proc/sys/kernel/random/uuid gives us a v4 UUID
	# without a userspace tool dependency — already a valid id; normalizing
	# it too keeps the derived path valid by construction.
	NODE_ID_FILE=/etc/rasputin/node-id
	if [ -z "$NODE_ID" ]; then
		if [ ! -s "$NODE_ID_FILE" ]; then
			mkdir -p "$(dirname "$NODE_ID_FILE")"
			cat /proc/sys/kernel/random/uuid > "$NODE_ID_FILE" 2>/dev/null || true
			chmod 0644 "$NODE_ID_FILE" 2>/dev/null || true
		fi
		NODE_ID=$(rasputin_label_normalize "$(cat "$NODE_ID_FILE" 2>/dev/null || true)")
	fi
fi
# Belt-and-suspenders for the (vanishingly unlikely) case where even the
# kernel UUID source failed — leaves the agent startable with a known-
# bad id rather than crashing on a UCI set with an empty value.
[ -z "$NODE_ID" ] && NODE_ID="unknown-node-id"

# Ensure /etc/config/rasputin exists. UCI's `commit` writes to an
# existing file but does NOT create one from scratch on first call —
# discovered during the CWWK bring-up 2026-06-07 when apply-seed
# silently failed to create the file. Touch is idempotent.
touch /etc/config/rasputin

# Originally this batch started with `delete rasputin.main` (defensive
# cleanup of a stale write). That delete fails when the section doesn't
# exist yet, and UCI's batch aborts silently on the failed delete —
# the downstream `set` + `commit` never run. Just `set` directly; UCI
# set semantics are "create or overwrite", so re-running apply-seed
# stays idempotent.
uci -q batch <<EOF
set rasputin.main='rasputin'
set rasputin.main.node_role='${RASPUTIN_NODE_ROLE:-firewall}'
set rasputin.main.nats_url='${RASPUTIN_NATS_URL:-}'
set rasputin.main.join_token='${RASPUTIN_CP_JOIN_TOKEN:-}'
set rasputin.main.node_id='${NODE_ID}'
set rasputin.main.cluster_id='${RASPUTIN_CLUSTER_ID:-rasputin}'
commit rasputin
EOF

# (Re)start the agent so a freshly-seeded box comes up without a manual start.
# `restart` = stop (a harmless no-op if already down) + start, so it brings the
# agent up whether or not it was running. The old `reload`-if-running left a
# fresh-flashed firewall's agent DOWN after first-boot seeding, because the init
# script opens no procd instance while nats_url is blank (so there was nothing
# running to reload). Found on the bench dev.11 final-flash, 2026-06-14.
if /etc/init.d/rasputin-agent enabled 2>/dev/null; then
	/etc/init.d/rasputin-agent restart 2>/dev/null || true
fi

logger -t rasputin "apply-seed: complete (seed populated: $([ -f "$SEED" ] && echo yes || echo no))"
