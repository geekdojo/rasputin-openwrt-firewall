# Files preserved across `sysupgrade`. Same format as /etc/sysupgrade.conf
# — one path per line. OpenWrt's sysupgrade walks /lib/upgrade/keep.d/*
# and adds every line to the backup tar before writing the new image,
# then restores from the tar after first boot.
#
# What's in /etc/rasputin/:
#   - seed.env         operator-supplied controlplane URL + join token
#                      (delivered by the controlplane's bootstrap_firewall
#                      job or hand-edited; MUST survive sysupgrade or
#                      every firmware update would reset the firewall
#                      back to unconfigured state).
#   - trust/root-ca.pem  CI-injected at build, but if the operator ever
#                      rotates it locally that change should survive too.
#   - agent-state/     rasputin-agent state (RASPUTIN_AGENT_STATE_DIR,
#                      set in files/etc/init.d/rasputin-agent). Holds the
#                      updater's pending/health-check bookkeeping, which
#                      must outlive the very sysupgrade reboot it tracks.
#
# /etc/config/rasputin (UCI) is deliberately NOT in this list — it's
# regenerated by /usr/lib/rasputin/apply-seed on every boot from
# seed.env. Preserving it would just mask seed.env changes.
#
# Discovered during the CWWK x86-p5-n100 sysupgrade test 2026-06-07.
/etc/rasputin/

# Snort3 (IDS):
#   - /etc/config/snort        operator UCI tuning (changing home_net,
#                              flipping action, suppressing categories
#                              via include path, etc.) MUST survive
#                              sysupgrade. 99-rasputin only seeds initial
#                              values once on first boot via uci-defaults
#                              and then self-deletes, so the operator's
#                              tuning persists across reflashes only via
#                              this preservation.
#   - /etc/snort/rules/local.rules    operator's own custom rules,
#                              auto-picked-up by snort.uc's template
#                              loop. Bundled emerging-*.rules are NOT
#                              preserved — they refresh from the new
#                              image, which is the rule-update mechanism
#                              for v1 (independent rule pushes are a
#                              backlog item).
/etc/config/snort
/etc/snort/rules/local.rules

# Tailscale (mesh overlay):
#   - /etc/tailscale/             tailscaled state (machine key + headscale
#                                 node identity, state_file pinned in
#                                 /etc/config/tailscale). /var is tmpfs, so
#                                 this lives on the overlay; it MUST survive
#                                 sysupgrade or the firewall de-enrolls from
#                                 the mesh on every firmware update and would
#                                 need re-flashing the controlplane auth key.
#   - /etc/config/tailscale       our state-path + fw_mode pin. We ship it in
#                                 the overlay, but if the operator/controlplane
#                                 ever edits it (e.g. port), that survives too.
#   - /etc/rasputin/mesh/         per-installation Mesh CA bundle
#                                 (tailscaled-ca.pem, RASPUTIN_MESH_CA_BUNDLE),
#                                 written by rasputin-agent on enrollment and
#                                 trusted by tailscaled via SSL_CERT_FILE.
#                                 Covered by /etc/rasputin/ above, listed here
#                                 explicitly for documentation.
/etc/tailscale/
/etc/config/tailscale
/etc/rasputin/mesh/
