#!/bin/sh /etc/rc.common
#
# rasputin-dhcp-auto — LAN DHCP role for the Rasputin deployment modes.
#
# WHO DECIDES, IN ORDER
#   1. THE PERSISTED DEPLOYMENT MODE, when one exists. The control plane sends
#      firewall.set_active once the operator has chosen a mode; the agent
#      applies it and records it in $MODE_FILE. From then on that recorded
#      decision — not the network — decides whether this box serves LAN DHCP,
#      on this boot and every boot after it.
#   2. THE PROBE, and only before any mode has ever been recorded. That is the
#      first-boot bootstrap: nothing has chosen a mode yet, so the box has to
#      guess safely from what is on the wire.
#
#   The order matters because the probe's input is unauthenticated. Any DHCP
#   OFFER on the LAN — from the operator's existing router, or from anything
#   else that answers — reads as "someone else owns DHCP here". Before a mode
#   exists that is the right guess. After one exists it is a way for whatever
#   answers fastest at boot to switch off a service the operator chose, until
#   the agent reconnects and re-applies it (geekdojo/geekdojo-brain#543, F52).
#
# THE BOOTSTRAP PROBE (no mode recorded yet)
#   - No other DHCP server answering on br-lan → serve it (ignore=0). This is
#     the "Rasputin is my router" (Mode A) / learning sub-segment (Mode C)
#     case: nothing upstream hands out addresses, so the controlplane + the
#     operator's laptop depend on us for an IP to even reach the setup wizard.
#   - Another DHCP server already answering → back off (ignore=1). This is the
#     "plug into my existing LAN" (Mode B) case: the existing router owns DHCP;
#     serving it too would start a DHCP war on the operator's LAN.
#
#   Detection: a short udhcpc DISCOVER on br-lan with a no-op handler script,
#   so an OFFER is observed via udhcpc's exit status without ever reconfiguring
#   the interface (udhcpc exits 0 = a server answered, non-zero = nobody did).
#   Our own DHCP is silenced first (ignore=1 + reload) so the probe cannot
#   detect itself — bench 2026-07-05 saw dnsmasq up 9s before an S55 probe, so
#   init ordering alone cannot be relied on for that.
#
# dhcp.lan.force=1 IS ALWAYS SET
#   dnsmasq runs its OWN unauthenticated conflict probe at start and refuses to
#   serve DHCP on an interface where anything else answered ("refusing to
#   start, use 'option force 1' to override", /etc/init.d/dnsmasq). That is a
#   second, invisible copy of the same fail-open: it would silence a role this
#   script — or the control plane — had already decided. `force` is what turns
#   it off, so the decision above is the only one there is.
#
# START is AFTER dnsmasq (60) on purpose: we cannot rely on init ordering to
# keep our own DHCP server from answering the probe, so we explicitly silence
# it first and reload dnsmasq with the final answer either way.
START=65

# Where the agent records the deployment mode it last applied — "active" (this
# box is the Rasputin router: serve LAN DHCP) or "idle" (a LAN peer: do not).
# Written by the agent's firewall.set_active handler, on the overlay and inside
# keep.d/rasputin, so the decision survives reboot, A/B slot update and
# sysupgrade alike. RASPUTIN_DEPLOYMENT_MODE_FILE is for the behaviour tests;
# it is never set on the box.
MODE_FILE="${RASPUTIN_DEPLOYMENT_MODE_FILE:-/etc/rasputin/deployment-mode}"

# persisted_mode prints "active", "idle" or nothing at all. Anything else in
# the file — truncated, half-written, hand-edited — prints nothing, which means
# "no mode recorded" and falls through to the bootstrap probe. A mode we cannot
# read is not a mode.
persisted_mode() {
	[ -r "$MODE_FILE" ] || return 1
	# sed, not `tr -d '[:space:]'`: busybox tr does not read that as a
	# character class — it deletes the literal characters in the brackets, so
	# "active" came back as "tiv" and every recorded mode read as no mode. Found
	# running these tests under the box's own shell (bench, 2026-09-19).
	mode="$(head -1 "$MODE_FILE" 2>/dev/null | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')"
	case "$mode" in
		active|idle) printf '%s\n' "$mode" ;;
		*) return 1 ;;
	esac
}

# apply_dhcp_role sets dhcp.lan.ignore to $1 (0 = serve, 1 = do not) and pins
# dhcp.lan.force=1, then commits. It does not reload dnsmasq — the caller
# decides when that happens, because the probe path reloads twice.
apply_dhcp_role() {
	uci -q set dhcp.lan.ignore="$1"
	uci -q set dhcp.lan.force='1'
	uci -q commit dhcp
}

# reload_dnsmasq is a function (not an inline call) so the behaviour tests can
# observe it without a running dnsmasq.
reload_dnsmasq() {
	/etc/init.d/dnsmasq reload 2>/dev/null
}

# another_dhcp_server reports 0 when something else answered a DISCOVER on
# $1. A function for the same reason as reload_dnsmasq.
another_dhcp_server() {
	udhcpc -i "$1" -n -q -f -t 3 -T 2 \
		-s /usr/lib/rasputin/dhcp-detect.sh >/dev/null 2>&1
}

boot() {
	local iface="br-lan"

	mode="$(persisted_mode)"
	case "$mode" in
		active)
			apply_dhcp_role 0
			reload_dnsmasq
			logger -t rasputin "dhcp-auto: deployment mode 'active' recorded in $MODE_FILE — serving LAN DHCP (force=1; no probe)"
			return 0
			;;
		idle)
			apply_dhcp_role 1
			reload_dnsmasq
			logger -t rasputin "dhcp-auto: deployment mode 'idle' recorded in $MODE_FILE — LAN DHCP stays OFF (no probe)"
			return 0
			;;
	esac

	# No mode has ever been recorded: first-boot bootstrap. Silence our own LAN
	# DHCP first so the probe can't self-detect. A reload with ignore=1 keeps
	# DNS up but stops DHCP answers on the LAN.
	apply_dhcp_role 1
	reload_dnsmasq
	sleep 1

	if another_dhcp_server "$iface"; then
		logger -t rasputin "dhcp-auto: no deployment mode recorded and another DHCP server answered on $iface — LAN DHCP stays OFF (deferring to it) until the controlplane sets a mode"
		# ignore already 1; dnsmasq already reloaded with DHCP off.
	else
		logger -t rasputin "dhcp-auto: no deployment mode recorded and no other DHCP server on $iface — serving LAN DHCP until the controlplane sets a mode"
		apply_dhcp_role 0
		reload_dnsmasq
	fi
}

# A manual `start` (not at boot) does the same — handy for re-evaluating after
# a rewire without a reboot. With a mode recorded it re-asserts that mode.
start() {
	boot
}
