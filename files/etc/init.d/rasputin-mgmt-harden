#!/bin/sh /etc/rc.common
#
# rasputin-mgmt-harden — re-assert the firewall's management-plane floor on
# EVERY boot: LuCI/uhttpd off the LAN (loopback only), and a non-empty,
# unusable root password field. Idempotent; safe to run repeatedly.
#
# WHY AN INIT SCRIPT, NOT uci-defaults
#   uci-defaults run only on a fresh overlay and then self-delete, so a box
#   carried across an A/B slot update (which preserves the extroot /overlay,
#   /etc/config/uhttpd and /etc/shadow included) would never pick these up —
#   the fielded fleet would stay on the stock 0.0.0.0 LuCI listener and the
#   stock empty root password. An init script baked into the rootfs reaches
#   OTA-upgraded boxes too, because ImageBuilder stamps its rc.d symlink into
#   the squashfs (/rom) — the exact mechanism rasputin-ipv4-only (#132) was
#   validated over OTA on. So this carries no `enable` line in 99-rasputin;
#   the image's baked activation is what makes it run everywhere.
#
# WHAT IT ENFORCES
#   1. uhttpd (LuCI + the /ubus JSON-RPC endpoint) listens on loopback only.
#      Reached by the operator through `ssh -L` (geekdojo/geekdojo-brain#559).
#      Stock OpenWrt binds uhttpd to 0.0.0.0:80 and 0.0.0.0:443, which puts
#      LuCI AND rpcd's ubus endpoint on the LAN.
#   2. dropbear accepts PUBLIC KEYS ONLY — password auth off, root password
#      auth off — re-asserted UNCONDITIONALLY, every boot
#      (geekdojo/geekdojo-brain#545). There were two places that set this and
#      neither reached a fielded box reliably: 96-rasputin-dropbear-harden is
#      a uci-defaults script, which runs once on a fresh overlay and then
#      self-deletes, and apply-seed re-asserts it only when
#      /etc/dropbear/authorized_keys is non-empty — so a box whose key file
#      was emptied, or that came across an A/B slot update carrying a UCI
#      someone had flipped, kept password SSH on the LAN with nothing putting
#      it back. The rasputin-os side has never had the gap: dropbear runs
#      there with `-s` in its unit, so key-only is a property of every start.
#      This is the firewall's equivalent — no condition, every boot.
#
#      Unconditional matters most in the case the condition excluded. With no
#      authorized key there is simply no network shell, which is the intended
#      state for a box nobody has seeded a key onto; with password auth left
#      on, it is a root login prompt on the LAN instead.
#   3. root's /etc/shadow password field is non-empty and unusable when it is
#      otherwise empty. Stock OpenWrt ships `root:::` (empty), which lets
#      rpcd grant a full-ACL root session for an empty password over /ubus,
#      and which trips OpenWrt's blank-root-password dropbear patch. A
#      non-empty unusable value closes both. Key-only SSH is unaffected:
#      dropbear's public-key path never reads the password hash (verified on
#      the shipped OpenWrt 25.12.5 dropbear, geekdojo/geekdojo-brain#468).
#
#      It only fills an EMPTY field. A real hash delivered by the control
#      plane (/usr/lib/rasputin/set-root-hash, geekdojo/geekdojo-brain#558)
#      is left untouched, as is an already-locked field.
#   4. The console asks for a login — `system.@system[0].ttylogin=1` — once,
#      and only once, root actually HAS a password (F15, dec 6, and Bryce's
#      2026-09-19 ruling on geekdojo/geekdojo-brain#587). Stock OpenWrt
#      leaves ttylogin unset, and /usr/libexec/login.sh then does
#      `exec /bin/login -f root`: the serial port and the BMC serial-over-LAN
#      session hand out a root shell with no prompt at all. Verified in
#      OpenWrt v25.12.5's package/base-files, the release this image builds
#      from.
#
#      THE GATE IS THE POINT. ttylogin is turned on ONLY when root's shadow
#      field is a real crypt hash. With the `*` lock of step 3, or an empty
#      field, no password can ever authenticate, so a login prompt would not
#      harden the box — it would lock the operator out of the one channel
#      that still works when the network does not. So: no password, no
#      prompt; a delivered password, a prompt. Never the other order.
#
#      It only ever turns ttylogin ON. An operator who set it deliberately is
#      not overridden, and it is never set back to 0 — a box that once had a
#      password does not go back to handing out a root shell.
#
# START=49: before uhttpd (START=50) and before dropbear (START=19 — already
# started, which is why the dropbear step reloads), so on every boot — first
# flash or an OTA-upgraded slot — uhttpd comes up already bound to loopback,
# with no LAN window. The root-hash step has no ordering constraint; it rides
# along here.
#
# NOTE ON SCOPE: this closes the NETWORK/rpcd vector (F16) and the console one
# (F15). What it does not decide is whether root has a password at all: that is
# the control plane's to deliver, and until it does, every channel here is
# key-only or unusable.

START=49

# /etc/shadow in production. RASPUTIN_SHADOW_FILE lets the behaviour tests point
# it at a scratch file; it is never set on the box.
SHADOW="${RASPUTIN_SHADOW_FILE:-/etc/shadow}"
# A non-empty field that no password can ever hash to. crypt() with a salt of
# "*" never yields "*", so rpcd's `$p$root` check and busybox login both refuse
# every password; dropbear key auth ignores it. This is the "no password set"
# floor until the control plane delivers a real hash.
LOCK='*'

harden_uhttpd() {
	# Only rewrite when it is not already loopback-only, so a steady-state boot
	# is a no-op (no needless commit / reload).
	http="$(uci -q get uhttpd.main.listen_http 2>/dev/null || true)"
	https="$(uci -q get uhttpd.main.listen_https 2>/dev/null || true)"
	want_http='127.0.0.1:80 [::1]:80'
	want_https='127.0.0.1:443 [::1]:443'

	if [ "$http" = "$want_http" ] && [ "$https" = "$want_https" ]; then
		return 1   # already loopback-only; nothing changed
	fi

	uci -q batch <<-EOF
		delete uhttpd.main.listen_http
		delete uhttpd.main.listen_https
		add_list uhttpd.main.listen_http='127.0.0.1:80'
		add_list uhttpd.main.listen_http='[::1]:80'
		add_list uhttpd.main.listen_https='127.0.0.1:443'
		add_list uhttpd.main.listen_https='[::1]:443'
		commit uhttpd
	EOF
	logger -t rasputin "mgmt-harden: uhttpd bound to loopback only (LuCI + /ubus off the LAN; reach it via ssh -L) [#559]"
	return 0
}

# harden_dropbear — key-only SSH, on every dropbear section, unconditionally.
#
# Every section: a UCI that has grown a second `config dropbear` (an operator
# opening a port, a package) would otherwise keep password auth on that one,
# and dropbear listens on all of them.
#
# Returns 0 when something changed (the caller reloads), 1 when the steady
# state was already correct — so an ordinary boot is silent and writes nothing.
harden_dropbear() {
	changed=1
	i=0
	while uci -q get "dropbear.@dropbear[$i]" >/dev/null 2>&1; do
		for opt in PasswordAuth RootPasswordAuth; do
			if [ "$(uci -q get "dropbear.@dropbear[$i].$opt")" != "off" ]; then
				uci -q set "dropbear.@dropbear[$i].$opt=off"
				changed=0
			fi
		done
		i=$((i + 1))
	done
	# No dropbear section at all: nothing listens, and there is nothing to
	# harden. Say so rather than report a change.
	[ "$i" -gt 0 ] || return 1
	if [ "$changed" = 0 ]; then
		uci -q commit dropbear
		logger -t rasputin "mgmt-harden: dropbear re-asserted to key-only SSH (password auth off on $i section(s)) [#545]"
	fi
	return "$changed"
}

harden_root_shadow() {
	[ -f "$SHADOW" ] || return 1

	# Second field of the root line is the password hash. Empty => stock
	# OpenWrt default; fill it with the unusable lock. Anything non-empty
	# (a real delivered hash, or an existing lock) is left alone.
	cur="$(awk -F: '$1=="root"{print $2; exit}' "$SHADOW")"
	if [ -n "$cur" ]; then
		return 1   # already set (locked or a delivered hash); leave it
	fi

	tmp="$SHADOW.rasputin.$$"
	# Verify with awk field equality, not grep: LOCK is '*', a regex metachar.
	if awk -v lock="$LOCK" -F: 'BEGIN{OFS=":"} $1=="root"{$2=lock} {print}' \
		"$SHADOW" > "$tmp" 2>/dev/null \
		&& chmod 600 "$tmp" 2>/dev/null \
		&& [ "$(awk -F: -v l="$LOCK" '$1=="root"{print ($2==l)?"y":"n"; exit}' "$tmp")" = y ] \
		&& mv -f "$tmp" "$SHADOW" 2>/dev/null
	then
		logger -t rasputin "mgmt-harden: root password field was empty; set to a non-empty unusable lock (key-only SSH unaffected) [#503]"
		return 0
	fi
	rm -f "$tmp" 2>/dev/null || true
	logger -t rasputin "mgmt-harden: WARNING — could not set the root lock in $SHADOW"
	return 1
}

# root_has_password reports whether root's shadow field is a real crypt hash —
# a modular-crypt value ($id$...), not empty and not a lock token. This is the
# FACT that gates the console login prompt: a password exists, so a prompt can
# be answered. Nothing here is clock-driven or "first boot" driven; the same
# check gives the same answer on every boot, which is what makes it safe to
# re-assert.
root_has_password() {
	[ -f "$SHADOW" ] || return 1
	_f="$(awk -F: '$1=="root"{print $2; exit}' "$SHADOW")"
	case "$_f" in
		'$'?*'$'* ) return 0 ;;
		* )         return 1 ;;
	esac
}

# harden_console_login turns the console login prompt on once root has a
# password. Returns 0 when it changed something.
#
# /usr/libexec/login.sh re-reads this value on EVERY console session (OpenWrt
# v25.12.5 package/base-files: `[ "$(uci -q get system.@system[0].ttylogin)" =
# 1 ] || exec /bin/login -f root`, run from inittab's `::askconsole:`), so a
# commit takes effect on the next session without a reboot.
harden_console_login() {
	root_has_password || return 1        # no password yet: a prompt would lock us out

	cur="$(uci -q get system.@system[0].ttylogin 2>/dev/null || true)"
	[ "$cur" = 1 ] && return 1           # already on; steady-state boot changes nothing

	uci -q batch <<-EOF
		set system.@system[0].ttylogin='1'
		commit system
	EOF
	logger -t rasputin "mgmt-harden: root has a delivered password, so the console now asks for a login (was: auto-root shell) [#587]"
	return 0
}

boot() {
	# On the boot path uhttpd has not started yet (START 49 < 50), so no reload
	# is needed — it will read the loopback config when it starts. dropbear
	# (START=19) HAS started, so a change there is reloaded; dropbear reads
	# PasswordAuth from UCI at start, and a reload is what makes the new value
	# take effect on the session-accepting process rather than at the next
	# reboot.
	harden_uhttpd || true
	if harden_dropbear && [ -x /etc/init.d/dropbear ]; then
		/etc/init.d/dropbear reload 2>/dev/null || /etc/init.d/dropbear restart 2>/dev/null || true
	fi
	harden_root_shadow || true
	# AFTER the shadow floor, deliberately: the floor may have just written the
	# `*` lock, and the gate must see the settled field rather than the one it
	# was about to replace.
	harden_console_login || true
}

# A manual `start` (operator or a bench run) does the same, and reloads uhttpd
# so a running box picks up the loopback binding without a reboot.
start() {
	changed=0
	harden_uhttpd && changed=1
	if harden_dropbear && [ -x /etc/init.d/dropbear ]; then
		/etc/init.d/dropbear reload 2>/dev/null || /etc/init.d/dropbear restart 2>/dev/null || true
	fi
	harden_root_shadow || true
	harden_console_login || true
	if [ "$changed" = 1 ] && [ -x /etc/init.d/uhttpd ]; then
		/etc/init.d/uhttpd reload 2>/dev/null || /etc/init.d/uhttpd restart 2>/dev/null || true
	fi
}
