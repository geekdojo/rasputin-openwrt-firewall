#!/bin/sh /etc/rc.common
#
# rasputin-agent — procd service for the Rasputin firewall agent.
# Started by procd after networking is up; auto-restarted on crash.
#
# Config: /etc/config/rasputin (UCI). Written by uci-defaults/99-rasputin
# on first boot from /etc/rasputin/seed.env.

USE_PROCD=1
START=90            # after network (S20-S40), firewall (S19), dnsmasq (S60)
STOP=10

start_service() {
	# Read UCI config (set by uci-defaults/99-rasputin from the seed).
	. /lib/functions.sh
	config_load rasputin
	local nats_url join_token join_token_file node_role node_id cluster_id bus_pin
	config_get nats_url   main nats_url
	config_get join_token main join_token
	config_get join_token_file main join_token_file /etc/rasputin/join.token
	config_get node_role  main node_role  firewall
	config_get node_id    main node_id
	config_get cluster_id main cluster_id rasputin
	config_get bus_pin    main bus_pin

	# If the operator hasn't filled the seed yet, log + back off — procd
	# will respawn on the configured cadence. Avoid a tight crash loop.
	# nats_url and node_id gate startup; the join token does not. The
	# controlplane's bus requires a join token by default
	# (RASPUTIN_BUS_AUTH=enforce) and accepts any connection when run with
	# RASPUTIN_BUS_AUTH=off, so the bus decides, not this gate.
	if [ -z "$nats_url" ]; then
		# No seed yet (fresh flash, pre-provision). Open NO procd instance and
		# return cleanly. Do not `sleep 60; exit 1`: start_service isn't a
		# supervised instance so procd never respawns it, and the blocking sleep
		# races the config-change reload trigger — together that left a freshly
		# flashed firewall's agent down after first-boot seeding. apply-seed
		# restarts us once the seed lands; the reload trigger covers later edits.
		logger -t rasputin-agent "seed not configured (nats_url blank); not starting until seeded"
		return 0
	fi
	# No node id: never start. The agent's own default id is the same literal
	# on every box, and this box never makes one up — the id is assigned by the
	# control plane and arrives in the seed (geekdojo/geekdojo-brain#423).
	# apply-seed refuses a seed without one, so this only trips on a UCI
	# config edited by hand, or one written before that check.
	if [ -z "$node_id" ]; then
		logger -t rasputin-agent "no node id (rasputin.main.node_id blank); not starting. Add RASPUTIN_NODE_ID to /etc/rasputin/seed.env and run /usr/lib/rasputin/apply-seed"
		return 0
	fi

	# The join token lives in its own 0600 file, and UCI carries only the path
	# (geekdojo/geekdojo-brain#537). A box seeded before that has the token as
	# rasputin.main.join_token instead, in a world-readable config file; move
	# it here, because apply-seed does not re-run on its own after an A/B slot
	# update — the overlay, /etc/config/rasputin included, is carried straight
	# across. The commit fires this service's own reload trigger once; the next
	# pass finds no legacy option and does nothing, so it settles immediately.
	#
	# Written to a temp file and renamed, and UCI is only cleared once that
	# succeeded: a box must never end up with the token in neither place.
	if [ -n "$join_token" ] && [ ! -s "$join_token_file" ]; then
		local jt_tmp="$join_token_file.tmp.$$"
		rm -f "$jt_tmp" 2>/dev/null
		if mkdir -p "$(dirname "$join_token_file")" \
			&& (umask 077 && printf '%s\n' "$join_token" > "$jt_tmp") \
			&& chmod 600 "$jt_tmp" \
			&& mv -f "$jt_tmp" "$join_token_file" \
			&& [ -s "$join_token_file" ]
		then
			uci -q set rasputin.main.join_token_file="$join_token_file"
			uci -q delete rasputin.main.join_token
			uci -q commit rasputin
			logger -t rasputin-agent "moved the join token out of /etc/config/rasputin into $join_token_file (0600)"
		else
			rm -f "$jt_tmp" 2>/dev/null
			logger -t rasputin-agent "WARNING: could not write the join token to $join_token_file; leaving it in /etc/config/rasputin and retrying next start"
		fi
	fi

	procd_open_instance
	procd_set_param command /usr/bin/rasputin-agent
	procd_append_param env RASPUTIN_NODE_ROLE="$node_role"
	procd_append_param env RASPUTIN_NATS_URL="$nats_url"
	# The token is handed over as a PATH, not a value: one 0600 file the agent
	# re-reads on every connect attempt (geekdojo/geekdojo-brain#537). Passed
	# even when the file is not there yet — a token that arrives later (a seed
	# applied, a re-mint) is then picked up on the next reconnect with no
	# restart, and until it does the bus refuses the node exactly as it always
	# has for a node with no token.
	#
	# The legacy inline value is passed ONLY when the migration above could not
	# write the file, so that a box whose /etc/rasputin is unwritable keeps the
	# credential it already has instead of dropping off the bus. An agent that
	# gets both prefers the file; this deliberately passes one or the other.
	if [ ! -s "$join_token_file" ] && [ -n "$join_token" ]; then
		logger -t rasputin-agent "WARNING: $join_token_file is missing, so the join token is being passed inline from /etc/config/rasputin. Fix $join_token_file: an inline token cannot be re-read while the agent runs."
		procd_append_param env RASPUTIN_CP_JOIN_TOKEN="$join_token"
	else
		procd_append_param env RASPUTIN_CP_JOIN_TOKEN_FILE="$join_token_file"
	fi
	procd_append_param env RASPUTIN_NODE_ID="$node_id"
	# The cluster's name, which the agent turns into "<cluster-id>.local" for
	# hostsync. Always passed (with a default) rather than conditionally: an
	# unset value here would leave the agent deriving its own default, which is
	# the same answer today but silently diverges the moment the default moves.
	procd_append_param env RASPUTIN_CLUSTER_ID="${cluster_id:-rasputin}"
	# The bus pin (geekdojo/geekdojo-brain#448): with it the agent dials the bus
	# over TLS and accepts only the server key that hashes to it. Written to UCI
	# by apply-seed, which has already refused a malformed one. Passed only when
	# set: with no pin the agent falls back to the pin file a controlplane
	# delivered into RASPUTIN_AGENT_STATE_DIR (below), and with neither it dials
	# in plaintext as before.
	[ -n "$bus_pin" ] && procd_append_param env RASPUTIN_BUS_PIN="$bus_pin"
	# Trust root for verifying signed update images before sysupgrade.
	procd_append_param env RASPUTIN_TRUST_ROOT=/etc/rasputin/trust/root-ca.pem
	# Agent state (updater bookkeeping, mock-backend state). Without this
	# the agent would mkdir ./agent-state relative to procd's cwd=/ — it
	# happens to work on the overlay but lands in an unowned root-level
	# dir and is lost on sysupgrade. /etc/rasputin/ is on the overlay AND
	# in the sysupgrade keep-list (files/lib/upgrade/keep.d/rasputin), so
	# update state survives the upgrade reboot it is meant to track.
	procd_append_param env RASPUTIN_AGENT_STATE_DIR=/etc/rasputin/agent-state
	# Mesh CA bundle path. On mesh enrollment the agent writes the
	# per-installation Mesh CA here so tailscaled can trust the self-hosted
	# headscale's TLS (tailscaled reads it via SSL_CERT_FILE — set in
	# files/etc/uci-defaults/99-rasputin). MUST be on the overlay (/var is
	# tmpfs) and in the sysupgrade keep-list so the trust root survives both
	# reboot and upgrade — /etc/rasputin/mesh/ is in keep.d/rasputin.
	procd_append_param env RASPUTIN_MESH_CA_BUNDLE=/etc/rasputin/mesh/tailscaled-ca.pem
	# Republish <cluster>.local (the per-cluster mDNS name, resolved over mDNS
	# for NATS) into a dnsmasq addn-hosts dir so tailscaled — which can't do mDNS
	# on musl — resolves the mesh login server at https://<cluster>.local, and so
	# any LAN client that queries this firewall gets the same name by unicast.
	# dnsmasq doesn't auto-watch addn-hosts, so hostsync runs
	# RASPUTIN_CP_HOSTS_RELOAD_CMD after each change to make it (and CP-IP changes)
	# take effect. Both unset on rasputin-os (systemd-resolved does mDNS natively).
	procd_append_param env RASPUTIN_CP_HOSTS_DIR=/etc/rasputin/hosts
	procd_append_param env RASPUTIN_CP_HOSTS_RELOAD_CMD="/etc/init.d/dnsmasq reload"

	procd_set_param respawn 3600 5 10   # threshold/timeout/retry (procd defaults shape)
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	# Restart the agent when the UCI config changes (e.g. operator
	# updates NATS URL via LuCI or a `uci set` from the controlplane).
	procd_add_reload_trigger rasputin
}
