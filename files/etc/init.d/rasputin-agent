#!/bin/sh /etc/rc.common
#
# rasputin-agent — procd service for the Rasputin firewall agent.
# Started by procd after networking is up; auto-restarted on crash.
#
# Config: /etc/config/rasputin (UCI). Written by uci-defaults/99-rasputin
# on first boot from /etc/rasputin/seed.env.

USE_PROCD=1
START=90            # after network (S20-S40), firewall (S19), dnsmasq (S60)
STOP=10

start_service() {
	# Read UCI config (set by uci-defaults/99-rasputin from the seed).
	. /lib/functions.sh
	config_load rasputin
	local nats_url join_token node_role node_id
	config_get nats_url   main nats_url
	config_get join_token main join_token
	config_get node_role  main node_role  firewall
	config_get node_id    main node_id

	# If the operator hasn't filled the seed yet, log + back off — procd
	# will respawn on the configured cadence. Avoid a tight crash loop.
	# Only nats_url gates startup: the controlplane does not enforce join
	# tokens yet (TOFU — architecture.md decision #14; enforcement is the
	# design-partner gate tracked in the backlog). Requiring a token here
	# blocked the first real firewall attach on the Mu bench (2026-06-12)
	# with a value nothing consumes. When token enforcement lands, the
	# agent itself will fail the NATS connect with a clear error — this
	# gate doesn't need to pre-empt it.
	if [ -z "$nats_url" ]; then
		# No seed yet (fresh flash, pre-provision). Open NO procd instance and
		# return cleanly. Do not `sleep 60; exit 1`: start_service isn't a
		# supervised instance so procd never respawns it, and the blocking sleep
		# races the config-change reload trigger — together that left a freshly
		# flashed firewall's agent down after first-boot seeding. apply-seed
		# restarts us once the seed lands; the reload trigger covers later edits.
		logger -t rasputin-agent "seed not configured (nats_url blank); not starting until seeded"
		return 0
	fi

	procd_open_instance
	procd_set_param command /usr/bin/rasputin-agent
	procd_append_param env RASPUTIN_NODE_ROLE="$node_role"
	procd_append_param env RASPUTIN_NATS_URL="$nats_url"
	procd_append_param env RASPUTIN_CP_JOIN_TOKEN="$join_token"
	[ -n "$node_id" ] && procd_append_param env RASPUTIN_NODE_ID="$node_id"
	# Trust root for verifying signed update images before sysupgrade.
	procd_append_param env RASPUTIN_TRUST_ROOT=/etc/rasputin/trust/root-ca.pem
	# Agent state (updater bookkeeping, mock-backend state). Without this
	# the agent would mkdir ./agent-state relative to procd's cwd=/ — it
	# happens to work on the overlay but lands in an unowned root-level
	# dir and is lost on sysupgrade. /etc/rasputin/ is on the overlay AND
	# in the sysupgrade keep-list (files/lib/upgrade/keep.d/rasputin), so
	# update state survives the upgrade reboot it is meant to track.
	procd_append_param env RASPUTIN_AGENT_STATE_DIR=/etc/rasputin/agent-state
	# Mesh CA bundle path. On mesh enrollment the agent writes the
	# per-installation Mesh CA here so tailscaled can trust the self-hosted
	# headscale's TLS (tailscaled reads it via SSL_CERT_FILE — set in
	# files/etc/uci-defaults/99-rasputin). MUST be on the overlay (/var is
	# tmpfs) and in the sysupgrade keep-list so the trust root survives both
	# reboot and upgrade — /etc/rasputin/mesh/ is in keep.d/rasputin.
	procd_append_param env RASPUTIN_MESH_CA_BUNDLE=/etc/rasputin/mesh/tailscaled-ca.pem
	# Republish rasputin.local (resolved over mDNS for NATS) into this dnsmasq
	# hostsdir so tailscaled — which can't do mDNS on musl — resolves the mesh
	# login server at https://rasputin.local. dnsmasq watches the dir (set in
	# 99-rasputin) and auto-reloads. Unset on rasputin-os (resolved does mDNS).
	procd_append_param env RASPUTIN_CP_HOSTS_DIR=/etc/rasputin/hosts

	procd_set_param respawn 3600 5 10   # threshold/timeout/retry (procd defaults shape)
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	# Restart the agent when the UCI config changes (e.g. operator
	# updates NATS URL via LuCI or a `uci set` from the controlplane).
	procd_add_reload_trigger rasputin
}
