# rasputin-seed.env (firewall) — provisioning seed, editable post-flash by
# mounting the root partition. uci-defaults/99-rasputin reads this on
# first boot, populates /etc/config/rasputin, and self-deletes (per the
# OpenWrt one-shot idiom). See os-images/provisioning.md.
#
# Leave RASPUTIN_NATS_URL/RASPUTIN_CP_JOIN_TOKEN blank for a sealed image;
# 99-rasputin then writes the bare config + waits, and the operator fills
# the values via SSH or the LuCI defaults page. Rasputin's bundled
# fulfillment path pre-fills these from the controlplane's
# `bootstrap_firewall` job (architecture.md §10).

# Role: firewall (this image is firewall-only — other roles run rasputin-os)
RASPUTIN_NODE_ROLE=firewall

# Control-plane NATS URL (typically a tailnet host).
RASPUTIN_NATS_URL=

# Join token minted by the controlplane.
RASPUTIN_CP_JOIN_TOKEN=
