# rasputin-seed.env (firewall) — provisioning seed, editable post-flash by
# mounting the root partition. uci-defaults/99-rasputin reads this on
# first boot, populates /etc/config/rasputin, and self-deletes (per the
# OpenWrt one-shot idiom). See os-images/provisioning.md.
#
# Leave RASPUTIN_NATS_URL/RASPUTIN_CP_JOIN_TOKEN blank for a sealed image;
# 99-rasputin then writes the bare config + waits, and the operator fills
# the values via SSH or the LuCI defaults page. Rasputin's bundled
# fulfillment path pre-fills these from the controlplane's
# `bootstrap_firewall` job (architecture.md §10).

# Role: firewall (this image is firewall-only — other roles run rasputin-os)
RASPUTIN_NODE_ROLE=firewall

# Node id. Optional — when blank, apply-seed derives a stable per-box id from
# DMI / a persistent UUID. The provisioning pipeline ASSIGNS this and binds the
# join token to it, so a matched-set seed sets it explicitly (apply-seed honors
# a non-blank value). See token-provisioning-pipeline.md.
RASPUTIN_NODE_ID=

# The cluster's name (ADR-0003). Blank = "rasputin", which is what every
# cluster provisioned before per-cluster naming is called — so leaving this
# empty keeps resolving the control plane at rasputin.local. Set it ONLY to the
# same value the rest of the cluster was provisioned with: the agent turns it
# into "<cluster-id>.local" and republishes that into dnsmasq, and on this box
# that is the only way tailscaled reaches the mesh login server (musl has no
# nss-mdns). A mismatch here does not error — the mesh just never connects.
RASPUTIN_CLUSTER_ID=

# Control-plane NATS URL (typically a tailnet host).
RASPUTIN_NATS_URL=

# Join token minted by the controlplane.
RASPUTIN_CP_JOIN_TOKEN=

# SSH authorized public key for root (optional). One key line, and it MUST be
# double-quoted — the value contains spaces and this file is sourced by sh:
#   RASPUTIN_SSH_AUTHORIZED_KEY="ssh-ed25519 AAAA... you@laptop"
# apply-seed appends it (if missing) to /etc/dropbear/authorized_keys — the
# overlay is writable, and dropbear reads that path natively on OpenWrt.
# SSH is key-only and the image bakes NO key — this field is the ONLY way in
# over the network (LuCI + console work without it). To revoke a key, edit
# /etc/dropbear/authorized_keys.
RASPUTIN_SSH_AUTHORIZED_KEY=
