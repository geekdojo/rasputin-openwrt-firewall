#!/bin/sh
#
# 99-rasputin — first-boot UCI seed for the Rasputin firewall.
#
# Runs once on first boot (uci-defaults scripts execute in order and
# self-delete on exit 0 — the canonical OpenWrt seed mechanism, analogous
# to the Buildroot firstboot oneshot in os-images/provisioning.md).
#
# What it does:
#   1. WAN/LAN port assignment for the i226-V dual NIC (eth1=WAN, eth0=LAN).
#   2. nftables software flowtable offload.
#   3. Calls /usr/lib/rasputin/apply-seed to read /etc/rasputin/seed.env
#      (if present) and write /etc/config/rasputin. Blank seed is fine —
#      the agent polls and waits.
#   4. Enables the rasputin-agent service.
#
# Always exits 0. Earlier versions of this script deferred (exit 1) when
# the seed file was missing, which left port assignment + flowtable
# unapplied on every box without a pre-populated seed — discovered on the
# CWWK x86-p5-n100 bring-up 2026-06-07. The agent itself already handles
# "no seed yet" by sleeping and retrying, so deferring at the uci-defaults
# level was redundant and buggy.

set -eu

logger -t rasputin "99-rasputin: applying first-boot UCI seed"

# --- WAN port assignment (eth1=WAN) ---
#
# Verified on the CWWK x86-p5-n100 (Node N reference hardware) 2026-06-06:
# chassis-labeled LAN port enumerates as eth0, WAN as eth1. Both ports
# are kmod-igc (i226-V). This matches OpenWrt 24.10's stock x86 generic
# board.d default exactly — ucidef_set_interfaces_lan_wan "eth0" "eth1".
# We assert the WAN device explicitly anyway (so a future stock change
# doesn't silently break us) and leave LAN alone.
#
# Important: don't mutate network.lan. The stock config binds the LAN
# interface to the `br-lan` device, with eth0 in that bridge's ports
# list. An earlier version of this script `uci delete network.lan.device`
# + `uci add_list network.lan.ports=eth0` — both wrong: the first
# removed the LAN interface's device binding, the second added a phantom
# list nobody reads (ports live on the device config, not the interface
# config). Discovered during the CWWK x86-p5-n100 bring-up 2026-06-07:
# dev.2 flashed boxes lost LAN DHCP because of this. Fixed in dev.3.
uci -q batch <<'EOF'
set network.wan=interface
set network.wan.device='eth1'
set network.wan.proto='dhcp'
commit network
EOF

# --- nftables software flowtable offload (the i226-V tier has no HW offload) ---
uci -q batch <<'EOF'
set firewall.@defaults[0].flow_offloading='1'
set firewall.@defaults[0].flow_offloading_hw='0'
commit firewall
EOF

# --- mDNS resolution for rasputin.local via dnsmasq (mesh login server) ---
# tailscaled connects to the mesh login server at https://rasputin.local:18080,
# but OpenWrt/musl has no mDNS resolver so .local lookups fail (NXDOMAIN). The
# agent already resolves rasputin.local over multicast DNS for NATS; its
# hostsync loop republishes the address into /etc/rasputin/hosts (via
# RASPUTIN_CP_HOSTS_DIR, set in the agent init). Point dnsmasq at that dir so
# every local client — tailscaled included — resolves rasputin.local. dnsmasq
# watches a hostsdir and auto-reloads when the agent updates it, so it self-
# heals if the control plane's address changes (no DHCP reservation needed).
mkdir -p /etc/rasputin/hosts
# addnhosts (NOT hostsdir): OpenWrt's dnsmasq init only translates `addnhosts`
# into the generated config (→ addn-hosts=); `hostsdir` is silently dropped
# (bench 2026-06-18). addn-hosts accepts a directory and reads every file in
# it. The agent's hostsync writes rasputin.local here and runs
# `/etc/init.d/dnsmasq reload` (RASPUTIN_CP_HOSTS_RELOAD_CMD in the agent init)
# after each change — addn-hosts files are not auto-watched, so the reload is
# what makes the new entry (and CP-IP changes) take effect.
uci -q batch <<'EOF'
add_list dhcp.@dnsmasq[0].addnhosts='/etc/rasputin/hosts'
commit dhcp
EOF

# --- Apply seed (writes /etc/config/rasputin; blank values are OK) ---
/usr/lib/rasputin/apply-seed || logger -t rasputin "99-rasputin: apply-seed returned non-zero (continuing)"

# --- Snort3 IDS in tap mode (decision locked 2026-06-08) ---
#
# The OpenWrt snort3 package supports tap-mode capture as a first-class
# UCI option (method=pcap reads packets via libpcap in promiscuous mode
# on the named interface — the kernel's forwarding path and our
# flow_offloading fast path are completely undisturbed). action=alert is
# the belt-and-suspenders safety: even if a rule body says "drop" or
# "block", snort only logs. v1 is detection-only by design; the N100
# doesn't do inline IPS at line rate (firewall-image.md §2).
#
# We diverge from the package defaults in seven places:
#   enabled  0 → 1     turn the service on
#   manual   1 → 0     use UCI-driven config generation (snort-mgr setup),
#                      not the legacy 'snort -c /etc/snort/snort.lua' path
#   interface eth0 → eth1   our WAN is eth1 on the CWWK (and the locked
#                      Node N port assignment; see WAN block above)
#   action   default → alert    detection-only safety belt
#   log_dir  /var/log → /var/log/snort    keep snort's noise isolated;
#                      the agent tails alerts from this known location
#   home_net 192.168.1.0/24 → any    we tap eth1 (WAN), where everything
#                      snort sees is post-NAT — source IPs are the
#                      firewall's WAN IP, not the LAN client. Default
#                      HOME_NET would only match traffic destined to
#                      LAN, missing scans/exploits hitting the WAN side.
#                      `any` widens HOME_NET so direction-aware rules
#                      fire for any traffic on the wire. Caught on the
#                      CWWK bring-up 2026-06-08.
#   include  '' → /etc/snort/rasputin-extra.lua    appended at end of
#                      snort-mgr's generated config; that file enables
#                      the alert_fast output module (snort.uc template
#                      ships it commented out) so the agent's IDS
#                      tailer has a file to read, and disables
#                      output.show_year (the YY/MM/DD format breaks
#                      the agent's MM/DD parser).
#
# All other options stay at the package defaults (mode=ids, method=pcap,
# external_net=any, snaplen=1518, logging=1, openappid=0).
uci -q batch <<'EOF'
set snort.snort.enabled='1'
set snort.snort.manual='0'
set snort.snort.interface='eth1'
set snort.snort.action='alert'
set snort.snort.log_dir='/var/log/snort'
set snort.snort.home_net='any'
set snort.snort.include='/etc/snort/rasputin-extra.lua'
commit snort
EOF

# --- Mesh CA trust for tailscaled ---
#
# tailscaled is a Go daemon and trusts the self-hosted headscale's TLS via
# the system cert pool. The per-installation Mesh CA isn't a public root, so
# the rasputin-agent installs it on mesh enrollment: it APPENDS the Mesh CA
# to /etc/ssl/certs/ca-certificates.crt — the first path Go's crypto/x509
# reads — then runs `/etc/init.d/tailscale restart`. Public DERP roots stay
# trusted (they're in the same bundle, shipped by ca-bundle). No env hook is
# needed in the stock tailscale init, which is why we do it agent-side: that
# init reads only log/port/state_file/fw_mode from UCI and forwards no
# arbitrary env to the daemon, and we must not override it (the package
# replaces its init on upgrade).
#
# The agent ALSO writes the CA to RASPUTIN_MESH_CA_BUNDLE
# (/etc/rasputin/mesh/tailscaled-ca.pem, env on the agent service below) — on
# this image that copy is the persistent record used to re-heal trust; on the
# Buildroot OS (read-only /etc) the same file is what tailscaled reads via
# SSL_CERT_FILE. One agent, both mechanisms; each no-ops where it doesn't fit.
#
# KNOWN FOLLOW-UP: a `ca-bundle` package upgrade (only via sysupgrade, not a
# plain reboot — /etc is the persistent overlay) rewrites
# /etc/ssl/certs/ca-certificates.crt and drops the appended Mesh CA. Trust is
# restored on the next mesh enroll/reconcile; a boot-time re-append from the
# persisted RASPUTIN_MESH_CA_BUNDLE copy is the planned hardening (tracked in
# the wiki backlog). BENCH-VERIFY: after enroll, `tailscale status` Running +
# the CA present in /etc/ssl/certs/ca-certificates.crt.
mkdir -p /etc/rasputin/mesh /etc/tailscale

# --- Enable services (do not start yet — uci-defaults runs pre-procd) ---
/etc/init.d/rasputin-agent enable
/etc/init.d/snort enable
/etc/init.d/tailscale enable
# Conflict-aware LAN DHCP: decide (each boot, before dnsmasq) whether to serve
# DHCP based on whether another server is already present. Serves it when we're
# the router (Mode A/C bootstrap — the cluster needs addresses to reach the
# wizard); backs off when an existing router owns DHCP (Mode B). See the script.
/etc/init.d/rasputin-dhcp-auto enable

logger -t rasputin "99-rasputin: provisioning complete"
exit 0
