#!/bin/sh
#
# 99-rasputin — first-boot UCI seed for the Rasputin firewall.
#
# Runs once on first boot (uci-defaults scripts execute in order and
# self-delete on exit 0 — the canonical OpenWrt seed mechanism, analogous
# to the Buildroot firstboot oneshot in os-images/provisioning.md).
#
# What it does:
#   1. WAN/LAN port assignment for the i226-V dual NIC (eth1=WAN, eth0=LAN).
#   2. nftables software flowtable offload.
#   3. Calls /usr/lib/rasputin/apply-seed to read /etc/rasputin/seed.env
#      (if present) and write /etc/config/rasputin. Blank seed is fine —
#      the agent polls and waits.
#   4. Enables the rasputin-agent service.
#
# Always exits 0. Earlier versions of this script deferred (exit 1) when
# the seed file was missing, which left port assignment + flowtable
# unapplied on every box without a pre-populated seed — discovered on the
# CWWK x86-p5-n100 bring-up 2026-06-07. The agent itself already handles
# "no seed yet" by sleeping and retrying, so deferring at the uci-defaults
# level was redundant and buggy.

set -eu

logger -t rasputin "99-rasputin: applying first-boot UCI seed"

# --- WAN port assignment (eth1=WAN) ---
#
# Verified on the CWWK x86-p5-n100 (Node N reference hardware) 2026-06-06:
# chassis-labeled LAN port enumerates as eth0, WAN as eth1. Both ports
# are kmod-igc (i226-V). This matches OpenWrt 24.10's stock x86 generic
# board.d default exactly — ucidef_set_interfaces_lan_wan "eth0" "eth1".
# We assert the WAN device explicitly anyway (so a future stock change
# doesn't silently break us) and leave LAN alone.
#
# Important: don't mutate network.lan. The stock config binds the LAN
# interface to the `br-lan` device, with eth0 in that bridge's ports
# list. An earlier version of this script `uci delete network.lan.device`
# + `uci add_list network.lan.ports=eth0` — both wrong: the first
# removed the LAN interface's device binding, the second added a phantom
# list nobody reads (ports live on the device config, not the interface
# config). Discovered during the CWWK x86-p5-n100 bring-up 2026-06-07:
# dev.2 flashed boxes lost LAN DHCP because of this. Fixed in dev.3.
uci -q batch <<'EOF'
set network.wan=interface
set network.wan.device='eth1'
set network.wan.proto='dhcp'
commit network
EOF

# --- nftables software flowtable offload (the i226-V tier has no HW offload) ---
uci -q batch <<'EOF'
set firewall.@defaults[0].flow_offloading='1'
set firewall.@defaults[0].flow_offloading_hw='0'
commit firewall
EOF

# --- Apply seed (writes /etc/config/rasputin; blank values are OK) ---
/usr/lib/rasputin/apply-seed || logger -t rasputin "99-rasputin: apply-seed returned non-zero (continuing)"

# --- Snort3 IDS in tap mode (decision locked 2026-06-08) ---
#
# The OpenWrt snort3 package supports tap-mode capture as a first-class
# UCI option (method=pcap reads packets via libpcap in promiscuous mode
# on the named interface — the kernel's forwarding path and our
# flow_offloading fast path are completely undisturbed). action=alert is
# the belt-and-suspenders safety: even if an ET Open rule body says
# "drop" or "block", snort only logs. v1 is detection-only by design;
# the N100 doesn't do inline IPS at line rate (firewall-image.md §2).
#
# We diverge from the package defaults in five places:
#   enabled  0 → 1     turn the service on
#   manual   1 → 0     use UCI-driven config generation (snort-mgr setup),
#                      not the legacy 'snort -c /etc/snort/snort.lua' path
#   interface eth0 → eth1   our WAN is eth1 on the CWWK (and the locked
#                      Node N port assignment; see WAN block above)
#   action   default → alert    detection-only safety belt
#   log_dir  /var/log → /var/log/snort    keep snort's noise isolated;
#                      the agent tails alerts from this known location
# All other options stay at the package defaults (mode=ids, method=pcap,
# external_net=any, home_net=192.168.1.0/24 matching OpenWrt's LAN
# default, snaplen=1518, logging=1, openappid=0).
uci -q batch <<'EOF'
set snort.snort.enabled='1'
set snort.snort.manual='0'
set snort.snort.interface='eth1'
set snort.snort.action='alert'
set snort.snort.log_dir='/var/log/snort'
commit snort
EOF

# --- Enable services (do not start yet — uci-defaults runs pre-procd) ---
/etc/init.d/rasputin-agent enable
/etc/init.d/snort enable

logger -t rasputin "99-rasputin: provisioning complete"
exit 0
