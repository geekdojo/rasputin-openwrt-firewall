#!/bin/sh
#
# 96-rasputin-dropbear-harden — first-boot SSH hardening for the firewall.
#
# Runs before 99-rasputin (uci-defaults execute in sorted order, then self-
# delete). Stock OpenWrt ships root with an EMPTY password and dropbear
# accepting password auth on the LAN — unacceptable for the security node.
#
# UNCONDITIONAL since the pre-GA vendor-key removal (2026-07-09): images bake
# no authorized key (the old build-time inject is gone), so the previous
# "harden only when a key was baked" gate would have left every public image
# with passwordless root on the LAN. Now the network vector is key-only from
# the very first boot, period — matching the rasputin-os posture (`dropbear
# -s`). The operator's key arrives via RASPUTIN_SSH_AUTHORIZED_KEY in
# seed.env (apply-seed, which also re-asserts this hardening on every run);
# with no key there is simply no network shell — LuCI and the local console
# remain, and seed.env can be edited by mounting the disk. No lockout, no
# passwordless window.
#
# Scope: this hardens the NETWORK vector (dropbear). Console/serial root stays
# as-is (physical access); a console password is a separate follow-up.

set -eu

uci -q batch <<'EOF'
set dropbear.@dropbear[0].PasswordAuth='off'
set dropbear.@dropbear[0].RootPasswordAuth='off'
commit dropbear
EOF
logger -t rasputin "dropbear hardened: key-only SSH (password auth disabled; supply a key via seed.env RASPUTIN_SSH_AUTHORIZED_KEY)"

exit 0
