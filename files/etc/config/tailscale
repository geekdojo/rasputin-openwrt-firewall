#
# Tailscale (mesh overlay) UCI config for the Rasputin firewall (Node N).
#
# Rasputin runs tailscaled under its OWN procd service,
# files/etc/init.d/rasputin-tailscale, which reads exactly these options from
# this file via `config_load tailscale`:
#   log_stdout, log_stderr, port, state_file, fw_mode
# It reads them with the same names and the same defaults as the stock
# /etc/init.d/tailscale (verified against openwrt/packages net/tailscale
# tailscale.init on the 24.10, 25.12 and master branches — all identical,
# 2026-06-17, and against the shipped 25.12.5 init on the bench 2026-09-19),
# so this file stays the one place the values live.
#
# The stock init is still shipped by the package and is still not overridden —
# rasputin-tailscale disables it on every start instead, because the stock init
# forwards no arbitrary env to the daemon and SSL_CERT_FILE is what the Mesh CA
# trust now rides on (see the NOTE below).
#
# We ship this file for two reasons:
#
# 1. STATE PERSISTENCE. tailscaled's node state (machine key, the headscale
#    node identity, the mesh auth) lives in `state_file`. The package
#    default is already /etc/tailscale/tailscaled.state — on the overlay
#    (persistent), NOT under /var (tmpfs, wiped every reboot). We pin it
#    explicitly so a future package-default change can't silently move it
#    onto tmpfs and de-enroll the firewall on every reboot, and so the
#    path is unambiguous for the keep.d sysupgrade preserve-list. Both
#    /etc/tailscale/ (state) and this file are listed in
#    files/lib/upgrade/keep.d/rasputin so enrollment survives sysupgrade.
#
# 2. fw_mode=nftables. Rasputin's firewall is nftables-only (see
#    packages.txt: nftables + kmod-nft-offload, no iptables-nft shim).
#    tailscaled defaults to nftables here too, but pinning it documents
#    the dependency and guards against a default flip.
#
# NOTE on Mesh CA trust: the per-installation Mesh CA that lets tailscaled
# trust the self-hosted headscale's TLS is written by rasputin-agent on
# enrollment to /etc/rasputin/mesh/tailscaled-ca.pem, and tailscaled is pointed
# at it with SSL_CERT_FILE by files/etc/init.d/rasputin-tailscale. It is NOT
# appended to the box's global CA bundle any more: that made the Mesh CA an
# anchor for every TLS client on the box, for every name
# (geekdojo/geekdojo-brain#542).
#
config settings 'settings'
	option log_stdout '1'
	option log_stderr '1'
	option port '41641'
	# Persistent overlay path — survives reboot (NOT on /var tmpfs) and,
	# via keep.d/rasputin, survives sysupgrade.
	option state_file '/etc/tailscale/tailscaled.state'
	# Rasputin is nftables-only.
	option fw_mode 'nftables'
