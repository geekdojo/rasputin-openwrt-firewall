# OpenWrt ImageBuilder is downloaded by scripts/init-imagebuilder.sh — large
# (~200 MB), reproducible from the pinned version, do not commit.
/imagebuilder/

# Build outputs
/build/
/dist/
*.img
*.img.gz
*.img.xz
*.sig

# Vendored agent binary — authenticated-fetched at build time from
# rasputin-control-plane release; never committed.
/files/usr/bin/rasputin-agent

# Trust root injected by CI from vars.RASPUTIN_ROOT_CA_PEM
/files/etc/rasputin/trust/root-ca.pem

# OS image version (CalVer) baked into the overlay at build time by the
# "Bake image version into overlay" workflow step; a committed file would go
# stale. The Buildroot OS writes the same /etc/rasputin/image-version.
/files/etc/rasputin/image-version

# Per-deployment provisioning seed (the .template is committed; bare name
# holds per-fleet secrets once filled).
/files/etc/rasputin/seed.env

# Snort3 Community ruleset — fetched at build time by
# scripts/fetch-snort-rules.sh (SHA pinned in that script for
# reproducibility). 1 .rules file (~4k rules) + sid-msg.map + licenses,
# ~1 MB compressed. Whole directory's contents are build-fetched and
# ignored EXCEPT rasputin-extra.lua — our lua override is committed; it
# gets included at the end of the snort-mgr-generated config by the
# 99-rasputin UCI `snort.snort.include` setting.
#
# Note: must ignore /files/etc/snort/* (not the dir itself) so the
# !rasputin-extra.lua re-include works; gitignore can't re-include a
# file inside an explicitly-ignored directory.
/files/etc/snort/*
!/files/etc/snort/rasputin-extra.lua

# OS noise
.DS_Store

# Signing material that must never be committed
*.key
*.pem
