# OpenWrt ImageBuilder is downloaded by scripts/init-imagebuilder.sh — large
# (~200 MB), reproducible from the pinned version, do not commit.
/imagebuilder/

# Build outputs
/build/
/dist/
*.img
*.img.gz
*.img.xz
*.sig

# Vendored agent binary — authenticated-fetched at build time from
# rasputin-control-plane release; never committed.
/files/usr/bin/rasputin-agent

# Trust root injected by CI from vars.RASPUTIN_ROOT_CA_PEM
/files/etc/rasputin/trust/root-ca.pem

# Per-deployment provisioning seed (the .template is committed; bare name
# holds per-fleet secrets once filled).
/files/etc/rasputin/seed.env

# ET Open snort3 ruleset — fetched at build time by
# scripts/fetch-snort-rules.sh (SHA pinned in that script for
# reproducibility). 47 .rules files + classification.config + sid-msg.map
# totalling ~55 MB; compresses to a few MB in squashfs. Never committed.
/files/etc/snort/rules/
/files/etc/snort/classification.config
/files/etc/snort/sid-msg.map
/files/etc/snort/.et-open-stamp
/files/etc/snort/BSD-License.txt
/files/etc/snort/LICENSE
/files/etc/snort/gpl-2.0.txt

# OS noise
.DS_Store

# Signing material that must never be committed
*.key
*.pem
